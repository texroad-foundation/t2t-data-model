@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix t2t: <https://texroad-foundation.github.io/t2t-data-model/> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit/percent_of_total_batch_weight> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> ;
    skos:notation "percent_of_total_batch_weight" ;
    skos:prefLabel "% of total batch weight"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit/percent_of_total_fiber_composition> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> ;
    skos:notation "percent_of_total_fiber_composition" ;
    skos:prefLabel "% of total fiber composition"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit/ppm> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> ;
    skos:notation "ppm" ;
    skos:prefLabel "PPM"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit> a skos:ConceptScheme ;
    dct:isPartOf t2t: ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <https://www.texroad.org> ;
    dct:title "Contaminant Amount Unit"@en ;
    owl:versionInfo "0.1.0" ;
    skos:hasTopConcept <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit/percent_of_total_batch_weight>,
        <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_amount_unit/percent_of_total_fiber_composition>,
