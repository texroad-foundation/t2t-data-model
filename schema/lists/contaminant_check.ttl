@prefix dct: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix t2t: <https://texroad-foundation.github.io/t2t-data-model/> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/detected> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> ;
    skos:notation "detected" ;
    skos:prefLabel "Detected"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/not_detected> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> ;
    skos:notation "not_detected" ;
    skos:prefLabel "Not detected"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/not_evaluated> a skos:Concept ;
    skos:inScheme <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> ;
    skos:notation "not_evaluated" ;
    skos:prefLabel "Not evaluated"@en ;
    skos:topConceptOf <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> .

<https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check> a skos:ConceptScheme ;
    dct:isPartOf t2t: ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <https://texroad.org> ;
    dct:title "Contaminant Check"@en ;
    owl:versionInfo "0.1.0" ;
    skos:hasTopConcept <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/detected>,
        <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/not_detected>,
        <https://texroad-foundation.github.io/t2t-data-model/lists/contaminant_check/not_evaluated> .

